{
  "comment": "Lexical path classes. A leading ~/ means the hook's $HOME. Matching is done on the canonicalised absolute path (.., ., // and ~ resolved without touching the filesystem).",
  "secret_prefixes": [
    "~/.ssh",
    "~/.gnupg",
    "~/.aws",
    "~/.config/gcloud",
    "~/.kube/config",
    "~/.docker/config.json",
    "~/.netrc",
    "~/.config/homelab-admin",
    "~/.config/op",
    "~/.password-store",
    "~/.local/share/keyrings",
    "~/.git-credentials",
    "~/.pgpass",
    "~/.npmrc",
    "~/.pypirc",
    "~/.config/gh/hosts.yml",
    "/etc/shadow",
    "/etc/gshadow",
    "/etc/sudoers",
    "/etc/ssh/ssh_host_",
    "~/.config/tea",
    "~/.config/rclone",
    "~/.bash_history",
    "~/.zsh_history",
    "~/.local/share/fish/fish_history",
    "~/.python_history",
    "~/.psql_history",
    "~/.mysql_history",
    "~/.config/sops",
    "~/.config/age",
    "~/.claude.json",
    "~/.claude/.credentials.json",
    "~/.vault-token",
    "~/.azure",
    "~/.oci",
    "~/.config/doctl",
    "~/.config/hcloud",
    "~/.config/glab-cli",
    "~/.config/hub",
    "~/.s3cfg",
    "~/.boto",
    "~/.terraform.d",
    "~/.mozilla",
    "~/.config/google-chrome",
    "~/.config/chromium",
    "~/.config/BraveSoftware",
    "~/.config/1Password",
    "~/.1password",
    "~/.config/Bitwarden",
    "~/.config/bw",
    "~/.local/share/atuin",
    "~/.config/keepassxc",
    "/etc/ssl/private",
    "/etc/letsencrypt",
    "/etc/wireguard",
    "/etc/NetworkManager/system-connections",
    "/etc/krb5.keytab",
    "/var/lib/tailscale",
    "/root"
  ],
  "secret_path_re": [
    "^/proc/.*/environ$",
    "^/proc/.*/(root|cwd|fd|map_files)(/|$)",
    "^/etc/ssh/ssh_host_[^/]*_key$",
    "^/etc/shadow-$",
    "^/etc/gshadow-$",
    "^/(root|home/[^/]+|Users/[^/]+)/\\.claude[^/]*/\\.credentials\\.json$"
  ],
  "secret_basename_re": [
    "^\\.env$",
    "^\\.env\\.",
    "\\.env$",
    "^\\.envrc$",
    "\\.pem$",
    "\\.key$",
    "\\.p12$",
    "\\.pfx$",
    "\\.kdbx$",
    "\\.keystore$",
    "\\.jks$",
    "id_rsa",
    "id_ed25519",
    "id_ecdsa",
    "id_dsa",
    "(?i)secret",
    "(?i)credential",
    "(?i)token",
    "^\\.netrc$",
    "^\\.pgpass$",
    "^id_[A-Za-z0-9_-]+$",
    "\\.age$",
    "^keys\\.txt$",
    "\\.ppk$",
    "\\.ovpn$",
    "^\\.?htpasswd$",
    "^acme\\.json$",
    "^kubeconfig",
    "(?i)priv(ate)?[-_.]?key",
    "^\\.vault-token$",
    "\\.tfstate(\\.backup)?$"
  ],
  "secret_exempt_basename_re": "(\\.pub$|^known_hosts(\\.old)?$)",
  "persist_path_re": [
    "/\\.ssh/authorized_keys2?$",
    "^~/\\.ssh/config$",
    "^~/\\.ssh/rc$",
    "^/etc/cron",
    "^/var/spool/cron",
    "^/etc/anacrontab$",
    "^/etc/systemd(/|$)",
    "^~/\\.config/systemd(/|$)",
    "^/usr/lib/systemd(/|$)",
    "^/lib/systemd(/|$)",
    "^/etc/sudoers",
    "^/etc/profile",
    "^/etc/bash\\.bashrc$",
    "^/etc/zsh/",
    "^/etc/environment$",
    "^/etc/ld\\.so\\.",
    "^/etc/rc\\.local$",
    "^/etc/init\\.d(/|$)",
    "^~/\\.config/autostart(/|$)",
    "^~/\\.config/fish/config\\.fish$",
    "^~/Library/LaunchAgents(/|$)",
    "^/Library/Launch(Agents|Daemons)(/|$)",
    "^~/\\.config/fish/conf\\.d(/|$)",
    "^~/\\.ssh/environment$",
    "^~/\\.pam_environment$",
    "^~/\\.config/environment\\.d(/|$)",
    "^~/\\.local/share/systemd(/|$)",
    "^/etc/xdg/autostart(/|$)",
    "^/etc/udev/rules\\.d(/|$)",
    "^/etc/modules-load\\.d(/|$)",
    "^/etc/modprobe\\.d(/|$)",
    "^/etc/pam\\.d(/|$)",
    "/\\.git/hooks(/|$)",
    "^~/\\.gitconfig$",
    "^~/\\.config/git/config$"
  ],
  "persist_basename_re": "^\\.(bashrc|zshrc|profile|bash_profile|bash_login|bash_logout|zprofile|zshenv|zlogin|zlogout|kshrc|mkshrc|cshrc|tcshrc|xprofile|xinitrc|xsessionrc)$",
  "device_re": "^/dev/(sd|hd|vd|xvd|nvme|mmcblk|md|dm-|loop|disk/|mapper/|nbd|sr)",
  "safe_write_targets": [
    "/dev/null",
    "/dev/stdout",
    "/dev/stderr",
    "/dev/fd/1",
    "/dev/fd/2"
  ],
  "registry_path_re": [
    "^~/\\.config/pip/pip\\.conf$",
    "^~/\\.pip/pip\\.conf$",
    "^/etc/pip\\.conf$",
    "^/etc/xdg/pip/pip\\.conf$",
    "^~/\\.config/uv/uv\\.toml$",
    "^/etc/uv/uv\\.toml$",
    "/\\.cargo/config(\\.toml)?$"
  ],
  "registry_basename_re": "^(\\.npmrc|pip\\.conf|pip\\.ini|uv\\.toml)$",
  "kernel_trigger_re": "^/proc/(sysrq-trigger|sys/kernel/sysrq)$"
}
