{
  "description": "Draw the status line (hooks module); refresh the installed statusLine stub on session start",
  "modules": [
    "./register.tsx"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/sync-install.sh"
          }
        ]
      }
    ]
  }
}
