#!/usr/bin/env bash
# questions — track a session's parked "questions for the user" in a state file
# so hooks/statusline can show a deterministic "input needed" flag.
#
# State: ${QUESTIONS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-questions}/<session>.json
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: questions [--session ID] <command> [args]

Session id comes from --session or $QUESTIONS_SESSION (one is required,
except for 'prune' and help).

Commands:
  add --title T [--context C] [--option O]... [--recommend R] [--new]
        Park a question. Refused (exit 3) if a similar open question exists
        unless --new is given.
  update <id> [--title T] [--context C] [--option O]... [--recommend R]
        Replace provided fields (any --option replaces the options list).
  answer <id> [--note N]
        Remove a question. --note is reserved and currently ignored.
  list [--full] [--json]
        One line per open question; --full adds context/options/recommendation;
        --json prints the questions array.
  count
        Print the number of open questions.
  prune [--days N]
        Delete state/lock files older than N days (default 7).
  help  Show this text.

State dir: $QUESTIONS_STATE_DIR, else ${XDG_STATE_HOME:-~/.local/state}/claude-questions
USAGE
}

STATE_DIR="${QUESTIONS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-questions}"
SESSION="${QUESTIONS_SESSION:-}"

die() {
  echo "questions: $*" >&2
  exit "${2:-1}"
}

if [[ "${1:-}" == "--session" ]]; then
  [[ $# -ge 2 ]] || die "--session requires a value" 2
  SESSION="$2"
  shift 2
fi

cmd="${1:-}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
  -h | --help | help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 2
    ;;
  add | update | answer | list | count | prune) ;;
  *)
    usage >&2
    exit 2
    ;;
esac

EMPTY='{"next_id":1,"questions":[]}'

if [[ "$cmd" != "prune" ]]; then
  [[ -n "$SESSION" ]] || die "no session: pass --session ID or set QUESTIONS_SESSION" 2
  [[ "$SESSION" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid session id: $SESSION" 2
  [[ "$SESSION" != "." && "$SESSION" != ".." ]] || die "invalid session id: $SESSION" 2
  STATE_FILE="$STATE_DIR/$SESSION.json"
  LOCK_FILE="$STATE_DIR/$SESSION.lock"
fi

# Take the per-session lock (held until the process exits).
lock() {
  mkdir -p "$STATE_DIR"
  exec 9>"$LOCK_FILE"
  flock 9
}

read_state() {
  if [[ -f "$STATE_FILE" ]]; then cat "$STATE_FILE"; else echo "$EMPTY"; fi
}

# write_state <json>: atomic tmp+mv in the same dir.
write_state() {
  local tmp
  tmp=$(mktemp "$STATE_DIR/.$SESSION.XXXXXX")
  printf '%s\n' "$1" >"$tmp"
  mv -f "$tmp" "$STATE_FILE"
}

need_id() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] || die "expected numeric question id, got '${1:-}'" 2
}

# Normalize + tokenize jq defs, shared by dedupe.
# shellcheck disable=SC2016 # jq program, not shell
JQ_TOK='
def stop: ["a","an","the","of","to","for","is","should","we","i","it","in","on","and","or","be","do","does","which","what","how"];
def toks: ascii_downcase | gsub("[^a-z0-9]+"; " ") | split(" ")
  | map(select(length > 0 and (. as $w | stop | index($w) | not))) | unique;
'

cmd_add() {
  local title="" context="" rec="" force=0
  local -a opts=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) title="${2:?--title needs a value}"; shift 2 ;;
      --context) context="${2:?--context needs a value}"; shift 2 ;;
      --option) opts+=("${2:?--option needs a value}"); shift 2 ;;
      --recommend) rec="${2:?--recommend needs a value}"; shift 2 ;;
      --new) force=1; shift ;;
      *) die "add: unknown argument: $1" 2 ;;
    esac
  done
  [[ -n "$title" ]] || die "add: --title is required" 2
  lock
  local state
  state=$(read_state)
  if [[ $force -eq 0 ]]; then
    local hit
    hit=$(jq -r --arg t "$title" "$JQ_TOK"'
      ($t | toks) as $nt
      | [ .questions[]
          | (.title | toks) as $ot
          | (($nt - ($nt - $ot)) | length) as $inter
          | (($nt + $ot) | unique | length) as $uni
          | {id, title, sim: (if $uni == 0 then 0 else ($inter / $uni) end)} ]
      | map(select(.sim >= 0.6)) | sort_by(-.sim) | first // empty
      | "\(.id)\t\(.title)"' <<<"$state")
    if [[ -n "$hit" ]]; then
      printf "similar to Q%s: %s — use 'update %s' or pass --new\n" "${hit%%$'\t'*}" "${hit#*$'\t'}" "${hit%%$'\t'*}" >&2
      exit 3
    fi
  fi
  local opts_json id new
  opts_json=$(if [[ ${#opts[@]} -gt 0 ]]; then printf '%s\n' "${opts[@]}" | jq -R . | jq -s .; else echo '[]'; fi)
  id=$(jq -r '.next_id' <<<"$state")
  new=$(jq --arg t "$title" --arg c "$context" --arg r "$rec" --argjson o "$opts_json" --argjson now "$(date +%s)" '
    .questions += [{id: .next_id, title: $t, context: $c, options: $o, recommendation: $r, added: $now}]
    | .next_id += 1' <<<"$state")
  write_state "$new"
  echo "Q$id added"
}

cmd_update() {
  need_id "${1:-}"
  local id="$1"
  shift
  local title="" context="" rec="" have_t=0 have_c=0 have_r=0
  local -a opts=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) title="${2:?--title needs a value}"; have_t=1; shift 2 ;;
      --context) context="${2:?--context needs a value}"; have_c=1; shift 2 ;;
      --option) opts+=("${2:?--option needs a value}"); shift 2 ;;
      --recommend) rec="${2:?--recommend needs a value}"; have_r=1; shift 2 ;;
      *) die "update: unknown argument: $1" 2 ;;
    esac
  done
  lock
  local state
  state=$(read_state)
  jq -e --argjson id "$id" 'any(.questions[]; .id == $id)' <<<"$state" >/dev/null || die "no such question: Q$id" 1
  local opts_json='null'
  if [[ ${#opts[@]} -gt 0 ]]; then
    opts_json=$(printf '%s\n' "${opts[@]}" | jq -R . | jq -s .)
  fi
  local new
  new=$(jq --argjson id "$id" --arg t "$title" --arg c "$context" --arg r "$rec" \
    --argjson ht "$have_t" --argjson hc "$have_c" --argjson hr "$have_r" --argjson o "$opts_json" '
    .questions |= map(if .id == $id then
        (if $ht == 1 then .title = $t else . end)
        | (if $hc == 1 then .context = $c else . end)
        | (if $hr == 1 then .recommendation = $r else . end)
        | (if $o != null then .options = $o else . end)
      else . end)' <<<"$state")
  write_state "$new"
  echo "Q$id updated"
}

cmd_answer() {
  need_id "${1:-}"
  local id="$1"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --note) shift 2 || true ;; # reserved; ignored
      *) die "answer: unknown argument: $1" 2 ;;
    esac
  done
  lock
  local state
  state=$(read_state)
  jq -e --argjson id "$id" 'any(.questions[]; .id == $id)' <<<"$state" >/dev/null || die "no such question: Q$id" 1
  write_state "$(jq --argjson id "$id" '.questions |= map(select(.id != $id))' <<<"$state")"
  echo "Q$id answered"
}

cmd_list() {
  local full=0 as_json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --full) full=1; shift ;;
      --json) as_json=1; shift ;;
      *) die "list: unknown argument: $1" 2 ;;
    esac
  done
  local state
  state=$(read_state)
  if [[ $as_json -eq 1 ]]; then
    jq '.questions' <<<"$state"
  elif [[ $full -eq 1 ]]; then
    jq -r '.questions[] | "Q\(.id) \(.title)",
      (if (.context // "") != "" then "  context: \(.context)" else empty end),
      (if (.options // []) | length > 0 then "  options:", (.options[] | "    - \(.)") else empty end),
      (if (.recommendation // "") != "" then "  recommendation: \(.recommendation)" else empty end)' <<<"$state"
  else
    jq -r '.questions[] | "Q\(.id) \(.title)"' <<<"$state"
  fi
}

cmd_count() {
  read_state | jq '.questions | length'
}

cmd_prune() {
  local days=7
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --days) days="${2:?--days needs a value}"; shift 2 ;;
      *) die "prune: unknown argument: $1" 2 ;;
    esac
  done
  [[ "$days" =~ ^[0-9]+$ ]] || die "prune: --days must be a non-negative integer" 2
  [[ -d "$STATE_DIR" ]] || exit 0
  find "$STATE_DIR" -maxdepth 1 -type f \( -name '*.json' -o -name '*.lock' \) -mtime "+$days" -delete
}

"cmd_$cmd" "$@"
